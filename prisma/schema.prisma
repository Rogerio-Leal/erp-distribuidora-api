generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE
  OPERADOR
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(OPERADOR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum PersonType {
  PF
  PJ
}

model Customer {
  id        String     @id @default(uuid())
  name      String
  document  String     @unique
  type      PersonType @default(PJ)
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  notes     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("customers")
}

model Supplier {
  id          String     @id @default(uuid())
  companyName String
  tradeName   String?
  document    String     @unique
  type        PersonType @default(PJ)
  email       String?
  phone       String?
  contact     String?
  address     String?
  city        String?
  state       String?
  notes       String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("suppliers")
}